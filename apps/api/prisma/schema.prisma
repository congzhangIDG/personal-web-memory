generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DailyDigest {
  id              Int      @id @default(autoincrement())
  date            String   @unique
  summary         String
  pageCount       Int
  totalDurationMs Int
  topDomains      String
  topics          String   @default("[]")
  favorited       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pages           PageVisit[]

  @@index([date])
}

model AppSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model PageVisit {
  id          Int      @id @default(autoincrement())
  url         String
  title       String
  domain      String
  visitedAt   Int
  durationMs  Int      @default(0)
  summary     String   @default("")
  topics      String   @default("[]")
  favorited   Boolean  @default(false)
  date        String
  digest      DailyDigest @relation(fields: [date], references: [date])
  createdAt   DateTime @default(now())

  @@unique([url, date])
  @@index([date])
  @@index([favorited])
}
